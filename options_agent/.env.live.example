# REAL MONEY — Alpaca LIVE account credentials.
#
# Copy this file to options_agent/.env.live (which is gitignored — NEVER commit real keys)
# and fill in your LIVE Alpaca account's key pair.
#
# The realmoney-profile containers load options_agent/.env first, then this file, so these
# values OVERRIDE the paper ALPACA_API_KEY/SECRET for those containers ONLY. Paper agents and
# all other tooling continue to use the paper keys and ALPACA_PAPER defaults to true (paper).
#
# ALPACA_PAPER=false is what flips the order-placement + chain-discovery clients to the live
# real-money endpoint. Without it, even with live keys, the code stays on the paper endpoint.

ALPACA_API_KEY=your_LIVE_account_key
ALPACA_SECRET_KEY=your_LIVE_account_secret
ALPACA_PAPER=false
