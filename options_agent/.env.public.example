# Public.com execution broker — REAL MONEY.
#
# Public's trading API has NO paper/sandbox — every non-dry-run order is real money.
# Copy this file to options_agent/.env.public (gitignored — NEVER commit real keys) and
# fill in your Public account's API secret + account number.
#
# A realmoney/live agent picks Public over Alpaca when BROKER=public. Market data, the
# 0DTE options chain, and OCC resolution still come from Alpaca, so the paper ALPACA_API_KEY/
# ALPACA_SECRET_KEY in options_agent/.env are still required alongside these.
#
# SAFETY: keep PUBLIC_DRY_RUN=true until verified. In dry-run, entries/exits are routed
# through Public's preflight endpoint (validated + logged, NOT placed). Set it to false only
# when you're ready to place real orders.

BROKER=public
PUBLIC_API_SECRET_KEY=your_public_api_secret_key
PUBLIC_ACCOUNT_NUMBER=your_public_account_number
PUBLIC_DRY_RUN=true
